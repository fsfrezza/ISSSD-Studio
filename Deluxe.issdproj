ro da tela.","areaAHelp":"-ÁREA A-\n Tipo de cursor\n            ………Na tela\n\n Área ………………LIGADA","areaBHelp":"-ÁREA B-\n Tipo de cursor\n            ………Na tela\n\n Área ………………DESLIGADA","areaCHelp":"-ÁREA C-\n Tipo de cursor\n          ………Campo inteiro\n\n Área ………………DESLIGADA","cursorAutoHelp":"-Movimento do cursor-\n…Automático\nMove o cursor para o jogador\nmelhor posicionado,\nautomaticamente.","cursorManualHelp":"-Movimento do cursor-\n…Manual\nPermite mover o cursor\npor conta própria.","keeperHelp":"-Selecionar o goleiro-\nPressione L e R juntos\npara assumir imediatamente\no controle manual\ndo goleiro."},"menuTexts":{"team-selection-native":{"data_87c5cd":"-SELEC.     TIME-"},"squad-native":{"data_87c60c":"ATÉ\nReservas"},"handicap-native":{"data_87c811":"-VANTAGEM-","data_87c884":" SELECT para trocar controles de 1P e CPU.","data_87c875":" 7\n 8\n 9\n10\n11"},"strategies-native":{"data_87c8ba":"NAO","data_87ca1d":"1 4"},"player-count-native":{"data_87ca25":"NÚMERO DE ATLETAS"},"stadium-native":{"data_87ca36":"-SELEC. ESTÁDIO-","data_87ca57":" -JOGO DE HOJE-","data_87ca67":"-JOGO NOTURNO-","data_87ca77":"CONDIÇÃO","data_87ca80":"NEVE\nBOM\nCHUV","data_87ca9b":" JAPÃO\n E.U.A.\nESPANHA\n ITÁLIA\nINGLAT.\nALEMAN.\n BRASIL\nNIGÉRIA","data_87cad3":"ESTÁDIO:"},"match-options-native":{"data_87cada":"INICIO"},"controls-help-native":{"data_87d2ec":"-Bola alta-\nUse para cruzar. Quanto mais\nsegurar o botão, mais alto\na bola irá.","data_87d3cc":"-Passe-\nUse para passes curtos. Para\nlevantar a bola, aperte o\nbotão sem pressionar uma\ndireção no direcional.\nAssim, você poderá cabecear\nou tentar uma bicicleta.","data_87d4ac":"-Chutar-\nAperte no campo adversário.\nQuanto mais segurar o botão,\nmais alto será o chute.","data_87d539":"-Correr-\nSegure o botão para correr.\nEvite usar por muito tempo,\npois o jogador poderá ficar\nsem resistência.","data_87d5e2":"-Goleiro-\nNo modo Manual ou Semiauto,\naperte A para saltar alto\ne B para mergulhar baixo.\nAo apertar X, o computador\ndecide se o goleiro deve\nsocar ou agarrar a bola.","data_87d6c3":"-Comandos do controle-\nTroque as páginas usando\nos botões L/R."},"results-native":{"data_87d73a":"NÃO DESISTA! - FIM DE JOGO -","data_87d75a":"VITÓRIA!","data_87d769":"PARABÉNS!"},"competitions-native":{"data_87d7a7":"1","data_87d7aa":"2","data_87d7ad":"3","data_87d7b2":"4","data_87d7b6":"5","data_87d7ba":"6","data_87d7bd":"7","data_87d7c2":"8","data_87d7c7":"PRÓX. JOGO   VS","data_87d892":"POSIÇÕES NA LIGA","data_87d8a2":"PONTUAÇÃO DA LIGA","data_87d8c4":"TABELA TORNEIO","data_87d91c":"-JOGO DE HOJE-","data_87d92a":"-RESULTADO DE HOJE-"},"penalties-native":{"data_87daa2":"Escolha a ordem dos jogadores.","data_87dad2":"Escolha o cobrador.","data_87db02":"O.K.?        A\nSIM/B\nNÃO"},"endings-native":{"data_87db40":"COPA INTERNACIONAL","data_87db54":"SÉRIE MUNDIAL","data_87db68":"SÉRIE MUNDIAL\nE O CAMPEONATO","data_87db92":"SÉRIE MUNDIAL\nE JOGO ESPECIAL","data_87dbb8":"Rumo ao próximo\nnível!","data_87dbda":"Agora desafie o\nmundo!","data_87dbfe":"Vamos tentar o\njogo especial!","data_87dc24":"Vença também a\nprimeira temporada","data_87dc4a":"Parabéns pela partida perfeita!","data_87dc82":"Parabéns por uma\nvitória perfeita!\nVocê é o melhor!","data_87dcba":"Vença também a\nsegunda temporada"},"rules-native":{"data_87dd89":"FAL.","data_87dd8d":"C. AMARELO","data_87dd98":"IMPEDIM.","data_87dda0":"G.OURO","data_87dda6":"PRORROG.","data_87ddaf":"SIM NÃO"},"options-native":{"data_87dde8":"NÍVEL","data_87ddf2":"DURAÇÃO","data_87de03":"SOM","data_87de08":"ESTÉR.","data_87de12":"REGRA"},"training-native":{"data_87de77":"TREINO","data_87de80":"DESAFIO","data_87de89":"Pratique os movimentos\nbásicos necessários\npara jogar bem\ne vencer as partidas.","data_87dee1":"Tente bater um novo\nrecorde competindo\ncontra o relógio.","data_87df65":"DRIBLE","data_87df6c":"PASSE","data_87df73":"CHUTE","data_87dfb7":"SAIR","data_87e808":"Use o campo inteiro para\ntreinar dribles, passes\ne chutes.","data_87e880":"Tire a bola dos três\natacantes que tentam\nmarcar um gol.","data_87e8f8":"Treine suas faltas.","data_87e970":"Defenda o gol controlando\no goleiro. Dois rivais\ntentarão marcar.","data_87df88":"N.","data_87df39":"LIVRE","data_87df3d":"DEFESA","data_87df52":"FALTA","data_87df5b":"GOLEIRO","data_87df61":"MODO"},"challenge-native":{"data_87dfbe":"RECORDE","data_87dfe8":"Drible os adversários e\npegue as bandeiras o mais\nrápido possível. Após pegar\ntodas, chute para marcar e\ntentar ganhar um bônus!","data_87e0c8":"Passe a bola rapidamente\npara todos os 10 jogadores,\nsem o goleiro. Depois, chute\npara receber pontos extras.","data_87e1a8":"Chute pelo trajeto indicado\npara evitar os rivais. Mire\nnos cantos do gol para\nganhar pontos extras.","data_87e288":"Roube a bola dos atacantes\no mais rápido possível.\nDepois, tente marcar um gol\npara ganhar pontos extras.","data_87e368":"No escanteio, mire direto\nno gol pelo trajeto indicado\nou faça um cruzamento.\nMire nos cantos do gol para\nganhar pontos extras.","data_87e448":"Evite a barreira e chute\ndireto ao gol ou tente um\ncruzamento. Mire nos cantos\npara ganhar pontos extras."},"records-native":{"data_87e9e8":"-SEU RECORDE-","data_87e9f5":"TMP.\n  :  :","data_87ea09":"PONT.TEMPO","data_87ea1c":"TMP. BÔNUS\n  :  :","data_87ea30":"PONT. BÔNUS","data_87ea8a":"Não se empolgue\ntanto. Este é apenas\num resultado mediano.","data_87eada":"Ótimo\nÉ um novo\nrecorde!\nInacreditável!","data_87eb2a":"Ainda não foi bom.\nTreine mais na\npróxima tentativa!","data_87eb7a":"Tente se esforçar\nmais da próxima vez.","data_87ebca":"Quase um novo\nrecorde.\nTente novamente.","data_87ec1a":"Foi bom, mas tente\nbater o recorde.","data_87ecaf":"DIGITE NOME"},"password-native":{"data_87edbd":"DESDE O INÍCIO","data_87edd6":"SENHA"},"scenario-native":{"data_87ee15":"N.","data_87ee3b":"N.1  ITÁLIA 1-2 CROÁCIA\n1:14 ESCANTEIO DA ITÁLIA","data_87ee73":"N.2  ALEMANHA 2-3 BULGÁRIA\n1:02 FALTA DA ALEMANHA","data_87eeab":"N.3  INGLATERRA 1-3 BRASIL\n1:54 ESCANTEIO DA INGLATERRA","data_87eee3":"N.4  ALEMANHA 0-0 ITÁLIA\n0:56 FALTA DA ALEMANHA","data_87ef1b":"N.5  TURQUIA 1-1 SUÉCIA\n0:49 LATERAL DA TURQUIA","data_87ef53":"N.6  BÉLGICA 1-1 ESPANHA\n0:42 FALTA DA BÉLGICA","data_87ef8b":"N.7  ROMÊNIA 0-1 POLÔNIA\n1:43 FALTA DA ROMÊNIA","data_87efc3":"N.8  ESCÓCIA 0-0 RÚSSIA\n1:24 TIRO DE META DA ESCÓCIA","data_87effb":"N.9  PORTUGAL 0-1 IRLANDA\n0:38 FALTA DE PORTUGAL","data_87f033":"N.10 ARGENTINA 2-2 BRASIL\n0:49 ESCANTEIO DA ARGENTINA","data_87f06b":"N.11 HOLANDA 1-3 REP.TCHECA\n1:38 FALTA DA HOLANDA","data_87f0a3":"N.12 INGLATERRA 1-1 JAPÃO\n0:02 ESCANTEIO DA INGLATERRA","data_87f12d":"Parece uma derrota da\nITÁLIA para a talentosa\nCROÁCIA. A ITÁLIA marcou\nno segundo tempo e agora\ntenta virar o jogo.","data_87f1c9":"A ALEMANHA vencia por dois\ngols, mas cedeu um pênalti\nà BULGÁRIA e agora perde\npor um gol. A BULGÁRIA é\numa seleção perigosa.","data_87f265":"A INGLATERRA,\nterra do\nfutebol\ncontra\no BRASIL,\natual\ncampeão. Os ingleses\nnão podem aceitar este\nplacar, em nome de seu\norgulho.","data_87f301":"A ALEMANHA não consegue\nmarcar contra a ITÁLIA,\nque não joga bem. Com\nessa falta, os alemães\nquerem virar a partida.","data_87f39d":"A TURQUIA joga muito bem\ncontra a SUÉCIA, que está\ncom sua melhor seleção.\nMais um gol pode trazer\numa vitória histórica.","data_87f439":"No último confronto, a\nBÉLGICA perdeu de goleada\npara a ESPANHA. Mesmo com\nvários desfalques, agora\na seleção belga quer\ndar o troco.","data_87f4d5":"A ROMÊNIA está em boa\nforma. Embora a POLÔNIA\nesteja na frente, ainda\nhá bastante tempo para\nvirar o jogo.","data_87f571":"A ESCÓCIA quer uma vaga\nnas finais na INGLATERRA.\nO mais importante agora\né vencer a RÚSSIA.","data_87f60d":"PORTUGAL recuperou sua\nboa forma, mas acaba de\nsofrer um gol contra.\nConcentre-se: ainda é\npossível vencer.","data_87f6a9":"O BRASIL é forte e parece\nmarcar de qualquer lugar.\nMas é o campeonato sul-\namericano, e a ARGENTINA\nprecisa reagir.","data_87f745":"A defesa da HOLANDA foi\ndestruída no segundo\ntempo. Se o ataque não\nreagir, a derrota será\ninevitável.","data_87f7e1":"A INGLATERRA sofreu um gol\nde um país da ÁSIA! Se o\njogo acabar empatado, será\ntão ruim quanto perder.","data_87f8dc":"NÃO FOI DESTA VEZ.\nTENTE NOVAMENTE.","data_87f900":"PARABÉNS!\nCENÁRIO CONCLUÍDO!","data_87f928":"CENÁRIO","data_87f938":"EM","data_87f93a":"VEZ!","data_87f93e":"VENCIDO","data_87f945":"CENÁRIOS CONCLUÍDOS","data_87f95a":"EM      VEZ!","data_87f966":"  PARABÉNS!"},"credits-native":{"data_87f990":"Você é o melhor!              FREZZATECH - WE GOT THE RIGHTS."},"game-type-native":{"friendly":"AMISTOSO","league":"LIGA CURTA","tournament":"TORNEIO CURTO","friendlyHelp":"X1 maroto","leagueHelp":"Max: 6 jogadores","tournamentHelp":"Max: 8 jogadores"}},"mainMenu":{"texts":{"openGame":"JOGATINA","scenario":"CENÁRIOS","championship":"CAMPEONATO","penalty":"PÊNALTIS","cup":"MEGACOPA","training":"TREINOS","password":"SENHA","options":"OPÇÕES"},"scale":95},"internalTitle":"INTERNETSSUCKERRELAX","sounds":{"ItsABigKick1":{"source":"galvao","brrBase64":""},"OverTheBar1":{"source":"galvao","brrBase64":""},"AmazingKick":{"source":"galvao","brrBase64":""},"Interception":{"source":"galvao","brrBase64":""},"HeShoots1":{"source":"galvao","brrBase64":""},"GoodLob2":{"source":"galvao","brrBase64":""},"TimeUp":{"source":"galvao","brrBase64":""},"TitleScreenNameDrop":{"source":"galvao","brrBase64":""},"PenaltyKick":{"source":"galvao","brrBase64":""},"NiceDummy1":{"source":"galvao","brrBase64":""},"UnknownIntroSample":{"source":"galvao","brrBase64":""},"NoFoul":{"source":"galvao","brrBase64":""},"OwnGoal":{"source":"galvao","brrBase64":""},"ItsOneOnOne":{"source":"galvao","brrBase64":""},"OhNo":{"source":"galvao","brrBase64":""},"LongBall1":{"source":"galvao","brrBase64":""},"MatchDraw":{"source":"galvao","brrBase64":""},"PastThePost1":{"source":"galvao","brrBase64":""},"DogBark":{"source":"galvao","b