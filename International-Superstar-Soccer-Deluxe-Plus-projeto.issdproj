          "scenario-native": {
            "data_87ee15": "N.",
            "data_87ee3b": "N.1  ITÁLIA 1-2 CROÁCIA\n1:14 ESCANTEIO DA ITÁLIA",
            "data_87ee73": "N.2  ALEMANHA 2-3 BULGÁRIA\n1:02 FALTA DA ALEMANHA",
            "data_87eeab": "N.3  INGLATERRA 1-3 BRASIL\n1:54 ESCANTEIO DA INGLATERRA",
            "data_87eee3": "N.4  ALEMANHA 0-0 ITÁLIA\n0:56 FALTA DA ALEMANHA",
            "data_87ef1b": "N.5  TURQUIA 1-1 SUÉCIA\n0:49 LATERAL DA TURQUIA",
            "data_87ef53": "N.6  BÉLGICA 1-1 ESPANHA\n0:42 FALTA DA BÉLGICA",
            "data_87ef8b": "N.7  ROMÊNIA 0-1 POLÔNIA\n1:43 FALTA DA ROMÊNIA",
            "data_87efc3": "N.8  ESCÓCIA 0-0 RÚSSIA\n1:24 TIRO DE META DA ESCÓCIA",
            "data_87effb": "N.9  PORTUGAL 0-1 IRLANDA\n0:38 FALTA DE PORTUGAL",
            "data_87f033": "N.10 ARGENTINA 2-2 BRASIL\n0:49 ESCANTEIO DA ARGENTINA",
            "data_87f06b": "N.11 HOLANDA 1-3 REP.TCHECA\n1:38 FALTA DA HOLANDA",
            "data_87f0a3": "N.12 INGLATERRA 1-1 JAPÃO\n0:02 ESCANTEIO DA INGLATERRA",
            "data_87f12d": "Parece uma derrota da\nITÁLIA para a talentosa\nCROÁCIA. A ITÁLIA marcou\nno segundo tempo e agora\ntenta virar o jogo.",
            "data_87f1c9": "A ALEMANHA vencia por dois\ngols, mas cedeu um pênalti\nà BULGÁRIA e agora perde\npor um gol. A BULGÁRIA é\numa seleção perigosa.",
            "data_87f265": "A INGLATERRA,\nterra do\nfutebol\ncontra\no BRASIL,\natual\ncampeão. Os ingleses\nnão podem aceitar este\nplacar, em nome de seu\norgulho.",
            "data_87f301": "A ALEMANHA não consegue\nmarcar contra a ITÁLIA,\nque não joga bem. Com\nessa falta, os alemães\nquerem virar a partida.",
            "data_87f39d": "A TURQUIA joga muito bem\ncontra a SUÉCIA, que está\ncom sua melhor seleção.\nMais um gol pode trazer\numa vitória histórica.",
            "data_87f439": "No último confronto, a\nBÉLGICA perdeu de goleada\npara a ESPANHA. Mesmo com\nvários desfalques, agora\na seleção belga quer\ndar o troco.",
            "data_87f4d5": "A ROMÊNIA está em boa\nforma. Embora a POLÔNIA\nesteja na frente, ainda\nhá bastante tempo para\nvirar o jogo.",
            "data_87f571": "A ESCÓCIA quer uma vaga\nnas finais na INGLATERRA.\nO mais importante agora\né vencer a RÚSSIA.",
            "data_87f60d": "PORTUGAL recuperou sua\nboa forma, mas acaba de\nsofrer um gol contra.\nConcentre-se: ainda é\npossível vencer.",
            "data_87f6a9": "O BRASIL é forte e parece\nmarcar de qualquer lugar.\nMas é o campeonato sul-\namericano, e a ARGENTINA\nprecisa reagir.",
            "data_87f745": "A defesa da HOLANDA foi\ndestruída no segundo\ntempo. Se o ataque não\nreagir, a derrota será\ninevitável.",
            "data_87f7e1": "A INGLATERRA sofreu um gol\nde um país da ÁSIA! Se o\njogo acabar empatado, será\ntão ruim quanto perder.",
            "data_87f8dc": "NÃO FOI DESTA VEZ.\nTENTE NOVAMENTE.",
            "data_87f900": "PARABÉNS!\nCENÁRIO CONCLUÍDO!",
            "data_87f928": "CENÁRIO",
            "data_87f938": "EM",
            "data_87f93a": "VEZ!",
            "data_87f93e": "VENCIDO",
            "data_87f945": "CENÁRIOS CONCLUÍDOS",
            "data_87f95a": "EM      VEZ!",
            "data_87f966": "  PARABÉNS!"
          },
